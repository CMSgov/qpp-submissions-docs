#
# NPM project configuration.
#
# See https://docs.npmjs.com/files/npmrc
# and https://docs.npmjs.com/misc/config
#
# Use `npm config list` to view the current configuration.
#

# Dependencies saved to package.json using --save, --save-dev or --save-optional
# will be configured with an exact version rather than using npm's default
# semver range operator.
#
# This helps protect us from unexpected changes in dependencies.
save-exact = true

# Enforce a 7-day minimum release age for 3rd-party packages at install time,
# in line with the Snyk AI-assisted security remediation policy. CMS-internal/
# trusted packages are exempted so they can be deployed same-day or next-day.
min-release-age=7
min-release-age-exclude[]=@cmsgov/*
min-release-age-exclude[]=qpp-*
